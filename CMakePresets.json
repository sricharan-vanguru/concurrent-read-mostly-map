{
  "version": 5,
  "configurePresets": [
    {"name": "debug", "generator": "Ninja", "binaryDir": "${sourceDir}/build/${presetName}", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"}},
    {"name": "release", "inherits": "debug", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}},
    {"name": "asan-ubsan", "inherits": "debug", "cacheVariables": {"READ_MOSTLY_ASAN_UBSAN": "ON"}},
    {"name": "tsan", "inherits": "debug", "cacheVariables": {"READ_MOSTLY_TSAN": "ON"}},
    {"name": "install", "inherits": "release", "cacheVariables": {"CMAKE_INSTALL_PREFIX": "${sourceDir}/build/install-prefix"}}
  ],
  "buildPresets": [
    {"name": "debug", "configurePreset": "debug"},
    {"name": "release", "configurePreset": "release"},
    {"name": "asan-ubsan", "configurePreset": "asan-ubsan"},
    {"name": "tsan", "configurePreset": "tsan"},
    {"name": "install", "configurePreset": "install", "targets": ["install"]}
  ],
  "testPresets": [
    {"name": "debug", "configurePreset": "debug", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "release", "configurePreset": "release", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "asan-ubsan", "configurePreset": "asan-ubsan", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "tsan", "configurePreset": "tsan", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}}
  ]
}
